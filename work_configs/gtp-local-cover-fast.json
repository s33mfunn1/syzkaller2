{
  "name": "gtp-local-cover-fast",
  "target": "linux/amd64",
  "http": "127.0.0.1:56743",
  "workdir": "/root/syzkaller2/workdir-gtp-local-fast",
  "kernel_obj": "/root/linux-stable",
  "image": "/root/image/trixie.img",
  "sshkey": "/root/image/trixie.id_rsa",
  "syzkaller": "/root/syzkaller2",
  "procs": 4,
  "cover": true,
  "raw_cover": true,
  "reproduce": false,
  "sandbox": "none",
  "preserve_corpus": true,
  "enable_syscalls": [
    "getpid",
    "gettid",
    "syz_open_procfs$namespace",
    "socket$nl_route",
    "socket$nl_generic",
    "socket$inet_udp",
    "socket$inet_udplite",
    "socket$inet6_udp",
    "socket$inet6_udplite",
    "sendmsg$nl_route_gtp",
    "syz_genetlink_get_family_id$gtp",
    "sendmsg$GTP_CMD_NEWPDP",
    "syz_extract_tcp_res",
    "syz_extract_tcp_res$synack",
    "ioctl$sock_SIOCGIFINDEX_gtp",
    "bind$inet",
    "bind$inet6",
    "syz_emit_ethernet"
  ],
  "no_mutate_syscalls": [
    "sendmsg$nl_route_gtp",
    "ioctl$sock_SIOCGIFINDEX_gtp",
    "sendmsg$GTP_CMD_NEWPDP",
    "syz_emit_ethernet"
  ],
  "experimental": {
    "remote_cover": false,
    "cover_edges": true,
    "descriptions_mode": "manual",
    "focus_areas": [
      {
        "name": "gtp",
        "filter": {
          "files": [
            "^drivers/net/gtp\\.c$"
          ]
        },
        "weight": 10.0
      },
      {
        "name": "rest",
        "weight": 1.0
      }
    ]
  },
  "type": "qemu",
  "vm": {
    "count": 3,
    "kernel": "/root/linux-stable/arch/x86/boot/bzImage",
    "cpu": 2,
    "mem": 2048,
    "cmdline": "net.ifnames=0"
  }
}
