# GTP TAP inject - syzkaller program matching /home/sasha/linux/gtp_tap_inject.c
# Packet: Eth(dst=TUN MAC aa:aa:aa:aa:aa:aa, src=02:02:02:02:02:02) -> IP(192.168.60.100->192.168.60.1) -> UDP(12345->2152) -> GTP1-U T-PDU(tid=0xdeadbeef) -> inner IP(192.168.1.1->192.168.1.2)
# No VLAN (gtp_tap_inject.c uses plain Ethernet)
syz_emit_ethernet(AUTO, &AUTO=@gtp_encap={@local, @gtp_src, @void, {0x800, {{0x5, 0x4, 0x0, 0x0, 0x38}, {0x3039, 0x868, 0x24, 0, @gtp_encap={}}}}}, 0x0)
