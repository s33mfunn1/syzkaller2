# GTP setup via syzlang only (no setup_ext_test/ip). Creates gtp0, assigns 192.168.60.1/24, injects GTP packet.
# Packet: Eth(dst=aa:aa:aa:aa:aa:aa, src=02:02:02:02:02:02) -> IP(192.168.60.100->192.168.60.1) -> UDP(12345->2152) -> GTP1-U
r0 = socket$nl_route(0x10, 0x3, 0x0)
r1 = socket$inet_udp(0x2, 0x2, 0x0)
sendmsg$nl_route_gtp(r0, &(0x7f0000000100)={&(0x7f0000000080)={0x10, 0x0, 0x0, 0x4000}, 0xc, &(0x7f00000000c0)={&(0x7f0000000140)=@newlink={0x58, 0x10, 0x605, 0x1, 0x0, {0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [@IFLA_IFNAME={0x14, 0x2, 0x0, 0x1, "gtp0"}, @IFLA_LINKINFO={0x20, 0x12, 0x0, 0x1, @gtp={{0x8, 0x1, 'gtp\x00'}, {0x14, 0x2, 0x0, 0x1, [@IFLA_GTP_CREATE_SOCKETS={0x5, 0x5, 0x1}, @IFLA_GTP_ROLE={0x8, 0x4, 0x1}, @IFLA_GTP_LOCAL={0x8, 0x7, 0xc0a83c01}]}}}]}, 0x58}, 0x1, 0x0, 0x0, 0x4008811}, 0x0)
ioctl$sock_SIOCGIFINDEX(r0, 0x8933, &(0x7f0000000200)={'gtp0\x00', <r2=>0x0})
sendmsg$nl_route_gtp(r0, &(0x7f0000000300)={&(0x7f0000000280)={0x10, 0x0, 0x0, 0x4000}, 0xc, &(0x7f00000002c0)={&(0x7f0000000340)=@ipv4_newaddr={0x74, 0x2, 0x605, 0x2, 0x0, {0x2, 0x18, 0x0, 0xfd, r2}, [@IFA_LOCAL={0x8, 0x5, 0xc0a83c01}, @IFA_ADDRESS={0x8, 0x5, 0xc0a83c01}, @IFA_LABEL={0x14, 0x2, 0x0, 0x1, "gtp0"}]}, 0x74}, 0x1, 0x0, 0x0, 0x20004084}, 0x0)
sendmsg$nl_route_gtp(r0, &(0x7f0000000500)={&(0x7f0000000480)={0x10, 0x0, 0x0, 0x4000}, 0xc, &(0x7f00000004c0)={&(0x7f0000000540)=@setlink={0x38, 0x10, 0x5, 0x3, 0x0, {0x0, 0x0, 0x0, r2, 0x1, 0x1}, []}, 0x38}, 0x1, 0x0, 0x0, 0x4008811}, 0x0)
syz_emit_ethernet(0x4a, &(0x7f0000000600)=@gtp_encap={{}, '\x02\x02\x02\x02\x02\x02', @void, {0x800, {{0x5, 0x4, 0x0, 0x0, 0x38}, {0x3039, 0x868, 0x24, 0, @gtp_encap={}}}}}, 0x0)
